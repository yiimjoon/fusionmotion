Input15 = InstanceInput { SourceOp = "TitleText", Source = "FadeOutFrames", Name = "Fade Out Frames", },
                StrokeEnabled = InstanceInput { SourceOp = "TitleText", Source = "Enabled2", Page = "Controls", Default = 0, Name = "스트로크 켜기", },
                StrokeThickness = InstanceInput { SourceOp = "TitleText", Source = "Thickness2", Page = "Controls", Default = 0.02, Name = "스트로크 두께", },
                StrokeColorR = InstanceInput { SourceOp = "TitleText", Source = "Red2", Page = "Controls", Default = 0, Name = "스트로크 색상", ControlGroup = 30, },
                StrokeColorG = InstanceInput { SourceOp = "TitleText", Source = "Green2", Page = "Controls", Default = 0, ControlGroup = 30, },
                StrokeColorB = InstanceInput { SourceOp = "TitleText", Source = "Blue2", Page = "Controls", Default = 0, ControlGroup = 30, },
                StrokeOpacity = InstanceInput { SourceOp = "TitleText", Source = "Opacity2", Page = "Controls", Default = 1, Name = "스트로크 불투명도", },
                ShadowEnabled = InstanceInput { SourceOp = "TitleText", Source = "Enabled3", Page = "Controls", Default = 0, Name = "그림자 켜기", },
                ShadowColorR = InstanceInput { SourceOp = "TitleText", Source = "Red3", Page = "Controls", Default = 0, Name = "그림자 색상", ControlGroup = 31, },
                ShadowColorG = InstanceInput { SourceOp = "TitleText", Source = "Green3", Page = "Controls", Default = 0, ControlGroup = 31, },
                ShadowColorB = InstanceInput { SourceOp = "TitleText", Source = "Blue3", Page = "Controls", Default = 0, ControlGroup = 31, },
                ShadowOpacity = InstanceInput { SourceOp = "TitleText", Source = "Opacity3", Page = "Controls", Default = 0.65, Name = "그림자 불투명도", },
                ShadowOffset = InstanceInput { SourceOp = "TitleText", Source = "Offset3", Page = "Controls", Default = { 0.006, -0.008 }, Name = "그림자 위치", },
                ShadowBlur = InstanceInput { SourceOp = "TitleText", Source = "SoftnessX3", Page = "Controls", Default = 2, Name = "그림자 블러", },
            },
            Outputs = { MainOutput1 = InstanceOutput { SourceOp = "TitleText", Source = "Output", Name = "Output", }, },
            ViewInfo = GroupInfo { Pos = { 0, 0 }, Size = { 300, 100, 150, 50 }, Direction = "Horizontal", },
            Tools = ordered() {
                TitleText = TextPlus {
                    NameSet = true,
                    Inputs = {
                        Name2 = Input { Value = "Stroke", },
                        Enabled2 = Input { Value = 0, },
                        ElementShape2 = Input { Value = 1, },
                        Type2 = Input { Value = 0, },
                        Thickness2 = Input { Value = 0.02, },
                        Red2 = Input { Value = 0, }, Green2 = Input { Value = 0, }, Blue2 = Input { Value = 0, },
                        Opacity2 = Input { Value = 1, },
                        Alpha2 = Input { Value = 1, Expression = "TitleText.Alpha1", },
                        PriorityBack2 = Input { Value = 7, },
                        Softness2 = Input { Value = 1, }, SoftnessX2 = Input { Value = 0, }, SoftnessY2 = Input { Value = 0, },
                        Name3 = Input { Value = "Shadow", },
                        Enabled3 = Input { Value = 0, },
                        ElementShape3 = Input { Value = 0, },
                        Type3 = Input { Value = 0, },
                        Red3 = Input { Value = 0, }, Green3 = Input { Value = 0, }, Blue3 = Input { Value = 0, },
                        Opacity3 = Input { Value = 0.65, },
                        Alpha3 = Input { Value = 1, Expression = "TitleText.Alpha1", },
                        PriorityBack3 = Input { Value = 6, }, Position3 = Input { Value = 1, },
                        Offset3 = Input { Value = { 0.006, -0.008 }, },
                        Softness3 = Input { Value = 1, }, SoftnessX3 = Input { Value = 2, },
                        SoftnessY3 = Input { Value = 2, Expression = "TitleText.SoftnessX3", },

                        GlobalOut = Input { Value = 20000, },
                        Width = Input { Value = 1920, }, Height = Input { Value = 1080, },
                        UseFrameFormatSettings = Input { Value = 1, },
                        StyledText = Input { Value = "YOUR TITLE", },
                        Font = Input { Value = "Open Sans", }, Style = Input { Value = "Bold", },
                        Size = Input { Expression = "TitleText.BaseSize", },
                        Center = Input { Expression = "Point(TitleText.Anchor.X+(-1)*TitleText.Distance*(1-TitleText.Eased),TitleText.Anchor.Y+(0)*TitleText.Distance*(1-TitleText.Eased))", },
                        Red1 = Input { Value = 1, }, Green1 = Input { Value = 1, }, Blue1 = Input { Value = 1, },
                        Alpha1 = Input { Expression = "TitleText.Opacity*iif(TitleText.FadeIn > 0.5,min(1,max(0,TitleText.Eased)),1)*iif(TitleText.FadeOutFrames > 0,min(1,max(0,(comp.RenderEnd-time)/max(1,TitleText.FadeOutFrames))),1)", },
                        CharacterSpacing = Input { Value = 1, },
                        MotionBlur = Input { Value = 0, },
                        VerticalTopCenterBottom = Input { Value = 1, },
                        VerticalJustificationNew = Input { Value = 3, },
                        HorizontalLeftCenterRight = Input { Value = 0, },
                        HorizontalJustificationNew = Input { Value = 3, },
                        BaseSize = Input { Value = 0.12, }, Anchor = Input { Value = { 0.5, 0.5 }, },
                        Opacity = Input { Value = 1, }, IntroFrames = Input { Value = 12, },
                        Easing = Input { Value = 0, }, FadeIn = Input { Value = 1, }, FadeOutFrames = Input { Value = 0, },
                        Progress = Input { Expression = "min(1,max(0,(time-comp.RenderStart)/max(1,TitleText.IntroFrames)))", },
                        Eased = Input { Expression = "iif(TitleText.Easing == 0, 1-(1-TitleText.Progress)*(1-TitleText.Progress)*(1-TitleText.Progress), iif(TitleText.Easing == 1, 1-(1-TitleText.Progress)*(1-TitleText.Progress)*(1-TitleText.Progress)*(1-TitleText.Progress), iif(TitleText.Easing == 2, 1-2.70158*(1-TitleText.Progress)*(1-TitleText.Progress)*(1-TitleText.Progress)+1.70158*(1-TitleText.Progress)*(1-TitleText.Progress), TitleText.Progress)))", },
                        Distance = Input { Value = 0.1, },
                        Comments = Input { Value = "Lightweight title: one Text+ render node. Shared normalized timing drives only this preset's motion, plus opacity. No Follower, TimeStretcher, image Transform, or blur.", },
                    },
                    UserControls = ordered() { BaseSize = { LINKS_Name = "Text Size", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 0.12, INP_MinAllowed = 0.001, INP_MaxAllowed = 1, INP_MinScale = 0.001, INP_MaxScale = 1, INP_Integer = false, IC_Visible = true, },
Anchor = { LINKS_Name = "Position", LINKID_DataType = "Point", INPID_InputControl = "OffsetControl", INPID_PreviewControl = "CrosshairControl", },
Opacity = { LINKS_Name = "Opacity", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 1, INP_MinAllowed = 0, INP_MaxAllowed = 1, INP_MinScale = 0, INP_MaxScale = 1, INP_Integer = false, IC_Visible = true, },
IntroFrames = { LINKS_Name = "Intro Frames", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 12, INP_MinAllowed = 1, INP_MaxAllowed = 120, INP_MinScale = 1, INP_MaxScale = 120, INP_Integer = true, IC_Visible = true, },
Easing = { LINKS_Name = "Easing", LINKID_DataType = "Number", INPID_InputControl = "ComboControl", INP_Default = 0, INP_Integer = true, {CCS_AddString = "Smooth"}, {CCS_AddString = "Snappy"}, {CCS_AddString = "Pop"}, {CCS_AddString = "Linear"}, },
FadeIn = { LINKS_Name = "Fade In", LINKID_DataType = "Number", INPID_InputControl = "CheckboxControl", CBC_TriState = false, INP_Default = 1, },
