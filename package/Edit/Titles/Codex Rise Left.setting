Progress = { LINKS_Name = "Internal Progress", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 0, INP_MinAllowed = 0, INP_MaxAllowed = 1, INP_MinScale = 0, INP_MaxScale = 1, INP_Integer = false, IC_Visible = false, },
Eased = { LINKS_Name = "Internal Easing", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 0, INP_MinAllowed = -10, INP_MaxAllowed = 10, INP_MinScale = -10, INP_MaxScale = 10, INP_Integer = false, IC_Visible = false, },
Distance = { LINKS_Name = "Travel Distance", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 0.1, INP_MinAllowed = 0, INP_MaxAllowed = 1, INP_MinScale = 0, INP_MaxScale = 1, INP_Integer = false, IC_Visible = true, }, },
                    ViewInfo = OperatorInfo { Pos = { 0, 0 } },
                },
            },
