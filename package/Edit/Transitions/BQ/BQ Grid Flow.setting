{
	Tools = ordered() {
		BQGridFlow = GroupOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				Columns = InstanceInput { SourceOp = "ControlHub", Source = "COLS", Name = "격자 밀도 (가로 칸)", Page = "Controls", Default = 5, },
				AutoSquare = InstanceInput { SourceOp = "ControlHub", Source = "AUTOSQUARE", Name = "정사각형 셀 자동 맞춤", Page = "Controls", Default = 1, },
				Rows = InstanceInput { SourceOp = "ControlHub", Source = "ROWS", Name = "세로 칸 (자동 해제 시)", Page = "Controls", Default = 5, },
				Direction = InstanceInput { SourceOp = "ControlHub", Source = "DIRECTION", Name = "등장 방식", Page = "Controls", Default = 11, },
				RandomSeed = InstanceInput { SourceOp = "ControlHub", Source = "SEED", Name = "랜덤 배열", Page = "Controls", Default = 1, },
				RevealFrames = InstanceInput { SourceOp = "ControlHub", Source = "REVEALFRAMES", Name = "리빌 길이 (프레임)", Page = "Controls", Default = 24, },
				RevealPosition = InstanceInput { SourceOp = "ControlHub", Source = "REVEALPOS", Name = "리빌 위치 (앞↔뒤)", Page = "Controls", Default = 0.5, },
				Timing = InstanceInput { SourceOp = "ControlHub", Source = "TIMING", Name = "움직임 곡선", Page = "Controls", Default = 3, },
				Spread = InstanceInput { SourceOp = "ControlHub", Source = "SPREAD", Name = "등장 시간차", Page = "Controls", Default = 0.82, },
				CellFade = InstanceInput { SourceOp = "ControlHub", Source = "FADE", Name = "셀 페이드", Page = "Controls", Default = 0.08, },
				GridEnabled = InstanceInput { SourceOp = "ControlHub", Source = "GRID", Name = "격자선 표시", Page = "Controls", Default = 1, },
				GridBorder = InstanceInput { SourceOp = "ControlHub", Source = "BORDER", Name = "외곽선 표시", Page = "Controls", Default = 0, },
				GridWidth = InstanceInput { SourceOp = "ControlHub", Source = "LINEPX", Name = "격자선 굵기 (px)", Page = "Controls", Default = 3, },
				GridColorR = InstanceInput { SourceOp = "GridInk", Source = "TopLeftRed", Name = "격자선 색상", Page = "Controls", ControlGroup = 1, Default = 0, },
				GridColorG = InstanceInput { SourceOp = "GridInk", Source = "TopLeftGreen", Page = "Controls", ControlGroup = 1, Default = 0, },
				GridColorB = InstanceInput { SourceOp = "GridInk", Source = "TopLeftBlue", Page = "Controls", ControlGroup = 1, Default = 0, },
				MainInput1 = InstanceInput { SourceOp = "ClipA", Source = "Input", },
				MainInput2 = InstanceInput { SourceOp = "ClipB", Source = "Input", },
			},
			Outputs = { MainOutput1 = InstanceOutput { SourceOp = "GridOverlay", Source = "Output", }, },
			Tools = ordered() {
				ControlHub = Background {
					CtrlWShown = false,
					Inputs = { Width = Input { Value = 1920, }, Height = Input { Value = 1080, }, UseFrameFormatSettings = Input { Value = 1, }, TopLeftAlpha = Input { Value = 0, }, COLS = Input { Value = 5, }, ROWS = Input { Value = 5, }, AUTOSQUARE = Input { Value = 1, }, DIRECTION = Input { Value = 11, }, REVEALFRAMES = Input { Value = 24, }, REVEALPOS = Input { Value = 0.5, }, TIMING = Input { Value = 3, }, SPREAD = Input { Value = 0.82, }, FADE = Input { Value = 0.08, }, SEED = Input { Value = 1, }, GRID = Input { Value = 1, }, BORDER = Input { Value = 0, }, LINEPX = Input { Value = 3, }, },
					UserControls = ordered() {
						COLS = { LINKS_Name = "격자 밀도 (가로 칸)", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Integer = true, INP_Default = 5, INP_MinScale = 2, INP_MaxScale = 8, INP_MinAllowed = 2, INP_MaxAllowed = 8, },
						ROWS = { LINKS_Name = "세로 칸 (자동 해제 시)", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Integer = true, INP_Default = 5, INP_MinScale = 2, INP_MaxScale = 12, INP_MinAllowed = 2, INP_MaxAllowed = 12, },
						AUTOSQUARE = { LINKS_Name = "정사각형 셀 자동 맞춤", LINKID_DataType = "Number", INPID_InputControl = "CheckboxControl", INP_Integer = false, INP_Default = 1, },
						DIRECTION = { { CCS_AddString = "왼쪽 → 오른쪽" }, { CCS_AddString = "오른쪽 → 왼쪽" }, { CCS_AddString = "위 → 아래" }, { CCS_AddString = "아래 → 위" }, { CCS_AddString = "대각선 좌상 → 우하" }, { CCS_AddString = "대각선 우하 → 좌상" }, { CCS_AddString = "대각선 우상 → 좌하" }, { CCS_AddString = "대각선 좌하 → 우상" }, { CCS_AddString = "중앙 → 바깥" }, { CCS_AddString = "바깥 → 중앙" }, { CCS_AddString = "체커보드" }, { CCS_AddString = "랜덤 셀" }, LINKS_Name = "등장 방식", LINKID_DataType = "Number", INPID_InputControl = "ComboControl", INP_Integer = true, INP_Default = 11, INP_MinScale = 0, INP_MaxScale = 11, },
						REVEALFRAMES = { LINKS_Name = "리빌 길이 (프레임)", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Integer = true, INP_Default = 24, INP_MinScale = 2, INP_MaxScale = 120, INP_MinAllowed = 1, INP_MaxAllowed = 1000, },
						REVEALPOS = { LINKS_Name = "리빌 위치 (앞↔뒤)", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Integer = false, INP_Default = 0.5, INP_MinScale = 0, INP_MaxScale = 1, INP_MinAllowed = 0, INP_MaxAllowed = 1, },
						TIMING = { { CCS_AddString = "선형" }, { CCS_AddString = "점점 빠르게" }, { CCS_AddString = "점점 느리게" }, { CCS_AddString = "부드러운 가감속" }, { CCS_AddString = "초반·후반 빠르게" }, LINKS_Name = "움직임 곡선", LINKID_DataType = "Number", INPID_InputControl = "ComboControl", INP_Integer = true, INP_Default = 3, INP_MinScale = 0, INP_MaxScale = 4, },
						SPREAD = { LINKS_Name = "등장 시간차", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Integer = false, INP_Default = 0.82, INP_MinScale = 0, INP_MaxScale = 0.98, INP_MinAllowed = 0, INP_MaxAllowed = 1, },
						FADE = { LINKS_Name = "셀 페이드", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Integer = false, INP_Default = 0.08, INP_MinScale = 0, INP_MaxScale = 0.4, INP_MinAllowed = 0, INP_MaxAllowed = 1, },
						SEED = { LINKS_Name = "랜덤 배열", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Integer = true, INP_Default = 1, INP_MinScale = 0, INP_MaxScale = 100, INP_MinAllowed = 0, INP_MaxAllowed = 10000, },
						GRID = { LINKS_Name = "격자선 표시", LINKID_DataType = "Number", INPID_InputControl = "CheckboxControl", INP_Integer = false, INP_Default = 1, },
						BORDER = { LINKS_Name = "외곽선 표시", LINKID_DataType = "Number", INPID_InputControl = "CheckboxControl", INP_Integer = false, INP_Default = 0, },
						LINEPX = { LINKS_Name = "격자선 굵기 (px)", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Integer = false, INP_Default = 3, INP_MinScale = 0.25, INP_MaxScale = 12, INP_MinAllowed = 0.1, INP_MaxAllowed = 100, },
					},
				},
				ClipA = PipeRouter { },
				ClipB = PipeRouter { },
				TimingCalc = Custom { CtrlWShown = false, Inputs = {
NumberIn1 = Input { Value = 0, Expression = "min(1,max(0,(time-comp.RenderStart)/max(1,comp.RenderEnd-comp.RenderStart)))", },
NumberIn2 = Input { Value = 0.1, Expression = "min(1,max(1,ControlHub.REVEALFRAMES)/max(1,comp.RenderEnd-comp.RenderStart))", },
NumberIn3 = Input { Value = 0.45, Expression = "min(1-TimingCalc.NumberIn2,max(0,ControlHub.REVEALPOS-TimingCalc.NumberIn2/2))", },
NumberIn4 = Input { Value = 0, Expression = "min(1,max(0,(TimingCalc.NumberIn1-TimingCalc.NumberIn3)/max(0.0001,TimingCalc.NumberIn2)))", },
NumberIn5 = Input { Value = 0, Expression = "iif(ControlHub.TIMING<0.5,TimingCalc.NumberIn4,iif(ControlHub.TIMING<1.5,(TimingCalc.NumberIn4)*(TimingCalc.NumberIn4),iif(ControlHub.TIMING<2.5,1-(1-(TimingCalc.NumberIn4))*(1-(TimingCalc.NumberIn4)),iif(ControlHub.TIMING<3.5,iif((TimingCalc.NumberIn4)<0.5,2*(TimingCalc.NumberIn4)*(TimingCalc.NumberIn4),1-2*(1-(TimingCalc.NumberIn4))*(1-(TimingCalc.NumberIn4))),0.5+0.5*((TimingCalc.NumberIn4)-0.5)+2*((TimingCalc.NumberIn4)-0.5)*((TimingCalc.NumberIn4)-0.5)*((TimingCalc.NumberIn4)-0.5)))))", },
NumberIn6 = Input { Value = 0, Expression = "iif(TimingCalc.NumberIn1<TimingCalc.NumberIn3,0,iif(TimingCalc.NumberIn1<min(1,TimingCalc.NumberIn3+TimingCalc.NumberIn2),1,2))", },
} },
				GridInk = Background { CtrlWShown = false, Inputs = { Width = Input { Value = 8, }, Height = Input { Value = 8, }, UseFrameFormatSettings = Input { Value = 0, }, TopLeftRed = Input { Value = 0, }, TopLeftGreen = Input { Value = 0, }, TopLeftBlue = Input { Value = 0, }, TopLeftAlpha = Input { Value = 1, }, }, },
				CellCanvas = Background {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 5, Expression = "ControlHub.COLS", },
						Height = Input { Value = 5, Expression = "iif(ControlHub.AUTOSQUARE>0.5,min(12,max(2,floor(ControlHub.COLS*ClipA.Output.Height/max(1,ClipA.Output.Width)+0.5))),ControlHub.ROWS)", },
						UseFrameFormatSettings = Input { Value = 0, },
						TopLeftRed = Input { Value = 0, }, TopLeftGreen = Input { Value = 0, }, TopLeftBlue = Input { Value = 0, }, TopLeftAlpha = Input { Value = 1, },
					},
				},
				RankMap = Custom {
					CtrlWShown = false,
					Inputs = {
						Image1 = Input { SourceOp = "CellCanvas", Source = "Output", },
						NumberIn1 = Input { Value = 5, Expression = "ControlHub.COLS", },
						NumberIn2 = Input { Value = 5, Expression = "iif(ControlHub.AUTOSQUARE>0.5,min(12,max(2,floor(ControlHub.COLS*ClipA.Output.Height/max(1,ClipA.Output.Width)+0.5))),ControlHub.ROWS)", },
						NumberIn3 = Input { Value = 11, Expression = "ControlHub.DIRECTION", },
						NumberIn4 = Input { Value = 1, Expression = "ControlHub.SEED", },
						NumberIn5 = Input { Value = 0.82, Expression = "ControlHub.SPREAD", },
						Intermediate1 = Input { Value = "min(n1-1,max(0,floor(x*n1)))", },
						Intermediate2 = Input { Value = "min(n2-1,max(0,floor(y*n2)))", },
						Intermediate3 = Input { Value = "i1/max(1,n1-1)", },
						Intermediate4 = Input { Value = "i2/max(1,n2-1)", },
						Intermediate5 = Input { Value = "i2*n1+i1", },
						Intermediate6 = Input { Value = "if(n3<0.5,i3,if(n3<1.5,1-i3,if(n3<2.5,i4,if(n3<3.5,1-i4,if(n3<4.5,(i3+i4)/2,if(n3<5.5,1-(i3+i4)/2,if(n3<6.5,((1-i3)+i4)/2,if(n3<7.5,(i3+(1-i4))/2,if(n3<8.5,min(1,sqrt((i3-0.5)^2+(i4-0.5)^2)/0.70710678),if(n3<9.5,1-(min(1,sqrt((i3-0.5)^2+(i4-0.5)^2)/0.70710678)),if(n3<10.5,if((i1+i2)%2<0.5,0.45*(i5/max(1,n1*n2-1)),0.55+0.45*(i5/max(1,n1*n2-1))),((i5*73+(n4+1)*37)%101)/100)))))))))))", },
						RedExpression = Input { Value = "min(1,max(0,i6*n5))", },
						GreenExpression = Input { Value = "min(1,max(0,i6*n5))", },
						BlueExpression = Input { Value = "min(1,max(0,i6*n5))", },
						AlphaExpression = Input { Value = "1", },
					},
				},
				ResizeMap = BetterResize {
					CtrlWShown = false,
					Inputs = {
						Input = Input { SourceOp = "RankMap", Source = "Output", },
						Width = Input { Value = 1920, Expression = "ClipA.Output.Width", },
						Height = Input { Value = 1080, Expression = "ClipA.Output.Height", },
						UseFrameFormatSettings = Input { Value = 0, }, KeepAspect = Input { Value = 0, }, FilterMethod = Input { Value = 0, }, UseGPU = Input { Value = 2, },
					},
				},
				CellDissolve = Dissolve {
					CtrlWShown = false,
					Inputs = {
						Background = Input { SourceOp = "ClipA", Source = "Output", }, Foreground = Input { SourceOp = "ClipB", Source = "Output", }, Map = Input { SourceOp = "ResizeMap", Source = "Output", },
						Operation = Input { Value = FuID { "DFTLumaRamp" }, },
						Mix = Input { Value = 0, Expression = "TimingCalc.NumberIn5", },
						["DFTLumaRamp.Softness"] = Input { Value = 0.08, Expression = "max(0.0001,ControlHub.FADE)", },
						["DFTLumaRamp.Border"] = Input { Value = 0, }, UseGPU = Input { Value = 2, },
					},
				},
				WindowSwitch = Switch {
					CtrlWShown = false,
					Inputs = {
						NumberOfInputs = Input { Value = 3, },
						Source = Input { Value = 0, Expression = "TimingCalc.NumberIn6", },
						Input0 = Input { SourceOp = "ClipA", Source = "Output", },
						Input1 = Input { SourceOp = "CellDissolve", Source = "Output", },
						Input2 = Input { SourceOp = "ClipB", Source = "Output", },
					},
				},
				EdgeLimiter = RectangleMask {
					CtrlWShown = false,
					Inputs = {
						Width = Input { Value = 0.99, Expression = "iif(ControlHub.BORDER>0.5,1,max(0,1-2*ControlHub.LINEPX/max(1,ClipA.Output.Width)))", },
						Height = Input { Value = 0.99, Expression = "iif(ControlHub.BORDER>0.5,1,max(0,1-2*ControlHub.LINEPX/max(1,ClipA.Output.Height)))", },
						Center = Input { Value = { 0.5, 0.5 }, }, SoftEdge = Input { Value = 0, }, BorderWidth = Input { Value = 0, }, Solid = Input { Value = 1, },
					},
				},
				GridOverlay = ofx.com.blackmagicdesign.resolvefx.Grid {
					CtrlWShown = false,
					Inputs = {
						Source = Input { SourceOp = "WindowSwitch", Source = "Output", }, EffectMask = Input { SourceOp = "EdgeLimiter", Source = "Mask", },
						vernum = Input { Value = 5, Expression = "iif(ControlHub.AUTOSQUARE>0.5,min(12,max(2,floor(ControlHub.COLS*ClipA.Output.Height/max(1,ClipA.Output.Width)+0.5))),ControlHub.ROWS)", }, hornum = Input { Value = 5, Expression = "ControlHub.COLS", }, majorspace = Input { Value = 0, },
						lineprop = Input { Value = 1, }, linecolorRed = Input { Value = 0, Expression = "GridInk.TopLeftRed", }, linecolorGreen = Input { Value = 0, Expression = "GridInk.TopLeftGreen", }, linecolorBlue = Input { Value = 0, Expression = "GridInk.TopLeftBlue", },
						horwidth = Input { Value = 0.00277778, Expression = "ControlHub.LINEPX/max(1,ClipA.Output.Height)", },
						verwidth = Input { Value = 0.0015625, Expression = "ControlHub.LINEPX/max(1,ClipA.Output.Width)", },
						majorwidth = Input { Value = 1, }, pan = Input { Value = 0, }, tilt = Input { Value = 0, }, zoom = Input { Value = 1, }, rotate = Input { Value = 0, }, gridwidth = Input { Value = 1, }, gridheight = Input { Value = 1, },
						Blend = Input { Value = 1, Expression = "ControlHub.GRID", }, UseGPU = Input { Value = 1, },
						blendIn = Input { Value = 1, }, blend = Input { Value = 0, }, ignoreContentShape = Input { Value = 0, }, legacyIsProcessRGBOnly = Input { Value = 0, }, IsNoTemporalFramesReqd = Input { Value = 0, }, srcProcessingAlphaMode = Input { Value = -1, }, dstProcessingAlphaMode = Input { Value = -1, }, resolvefxVersion = Input { Value = "1.0", },
					},
				},
			},
		},
	},
	ActiveTool = "BQGridFlow"
}
